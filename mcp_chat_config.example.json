{
  "llm": {
    "base_url": "https://api.openai.com/v1",
    "api_key": "PASTE_OPENAI_API_KEY_HERE",
    "api_key_env": "OPENAI_API_KEY",
    "model": "gpt-4o-mini",
    "temperature": 0.2,
    "timeout_s": 180
  },
  "system_prompt": "You are a terminal chat orchestrator. Decide when to call MCP tools, then summarize results for the user.\n\nYou can also use Backoffice tools (backoffice_*), including design-fiction artifact search, plus Digester editorial/digest tools like search_digests, get_signal, and generate_draft.",
  "strict_tool_facts": true,
  "tool_description_hints": {
    "photarium_search": "Use this for semantic and keyword image search in the Photarium catalog, including concept/color/style lookups.",
    "photarium_*": "Photarium tools operate on the Photarium catalog and image metadata.",
    "backoffice_design_artifacts_search": "Use this to search design-fiction artifacts in the Backoffice collections.",
    "backoffice_*": "Backoffice tools operate on content collections such as design_fiction_artifacts."
  },
  "servers": [
    {
      "name": "comfy",
      "transport": "stdio",
      "command": "/ABSOLUTE/PATH/TO/nfl-comfymcp/.venv/bin/python",
      "args": [
        "-m",
        "comfy_mcp.mcp_server.cli"
      ],
      "tool_prefixes": [
        "comfy_",
        "workflows_"
      ],
      "env": {
        "COMFY_MCP_COMFY_BASE_URL": "http://127.0.0.1:8188"
      }
    },
    {
      "name": "photarium",
      "transport": "stdio",
      "command": "/ABSOLUTE/PATH/TO/cloud-flare-image-handler/run_photarium_mcp_server.sh",
      "tool_prefixes": [
        "photarium_",
        "catalog_"
      ],
      "cwd": "/ABSOLUTE/PATH/TO/cloud-flare-image-handler",
      "env": {
        "PHOTARIUM_HTTP_ENABLED": "false",
        "PHOTARIUM_BASE_URL": "http://127.0.0.1:3000"
      }
    },
    {
      "name": "editorial",
      "transport": "stdio",
      "command": "/ABSOLUTE/PATH/TO/nfl-editorial/run_editorial_mcp_server.sh",
      "cwd": "/ABSOLUTE/PATH/TO/nfl-editorial",
      "tool_prefixes": [
        "editorial_",
        "adjacency_"
      ],
      "env": {
        "EDITORIAL_HTTP_ENABLED": "false"
      }
    },
    {
      "name": "backoffice",
      "transport": "stdio",
      "command": "/ABSOLUTE/PATH/TO/nfl-backoffice/.venv/bin/python",
      "args": [
        "mcp/mcp_backoffice_server.py"
      ],
      "cwd": "/ABSOLUTE/PATH/TO/nfl-backoffice",
      "tool_prefixes": [
        "backoffice_"
      ]
    },
    {
      "name": "digester",
      "transport": "stdio",
      "command": "/ABSOLUTE/PATH/TO/Digester/.venv/bin/python",
      "args": [
        "mcp_digester_server.py"
      ],
      "cwd": "/ABSOLUTE/PATH/TO/Digester",
      "tool_prefixes": [
        "digester_",
        "digest_",
        "signal_"
      ]
    },
    {
      "name": "workspace",
      "transport": "http",
      "http_url": "http://127.0.0.1:8777",
      "tool_prefixes": [
        "workspace_"
      ]
    }
  ]
}
